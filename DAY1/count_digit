import java.util.Scanner;

//scanner system sould be capital

//count digits

class rajeev{
    public static void main(String[]args){
        Scanner sc =new Scanner (System.in);

        System.out.println("enter no ");
        int num =sc.nextInt();

        int count =0;

        while (num>0){
            num/=10;
            count++;
        }

        System.out.println("no of digit in no " +count);

        sc.close();
    }
}
