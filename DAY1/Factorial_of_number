import java.util.Scanner;

//factorial of number
class main{
//public class Rajeev{
    public static void main(String[] args){
        Scanner sc =new Scanner (System.in);

        System.out.println("enter number ");
        int num= sc.nextInt();

       // int fact =1;
        long fact =1;

        for(int i=2;i<=num;i++){
            fact*=i;
        }

        System.out.println("factorial of " + num + " is "+fact);

        sc.close();
    }
}
