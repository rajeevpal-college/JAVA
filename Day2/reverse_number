//reverse a number
import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc =new Scanner(System.in);

        System.out.println("enter number ");
        int num=sc.nextInt();

        int revNum=0;

        while(num>0){
            revNum=revNum*10+num%10;
            num /=10;
        }

        System.out.println("reverse given no is "+ revNum);

        sc.close();
    }
}
