
import java.util.Scanner;
//find gcd
class rajeevjustname{
    public static void main(String[] args){
    Scanner sc=new Scanner(System.in);

    System.out.println("enter no");
    int num1=sc.nextInt();
    int num2=sc.nextInt();

    int gcd=1;
    int min= Math.min(num1,num2);//not Maths


    for(int i=1;i<=min;i++){
        if (num1%i==0&&num2%i==0){
            gcd=i;

        }
    }

    System.out.println("gcd of no is "+gcd);
    sc.close();
}
}
