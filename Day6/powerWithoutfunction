//power without function 
import java.util.Scanner;

public class justtnameclass{
    public static void main(String[]args){
        Scanner sc=new Scanner(System.in);
        System.out.println("enter x and n in x^n ");

        int x = sc.nextInt(), n=sc.nextInt();
        double power=1;
        if(x==0&&n==0){
            System.out.println("not defined ");
            sc.close();
            return;

        }else if(x==0){
            System.out.println("x^n =0");
            sc.close();
            return;

        }
        
        else if (n>0){
            for(int i=1;i<=n;i++){
                power *=x;
            }
        }
            else if (n<0){
            for(int i=1;i<=n;i++){
                power *=1.0/x;
            }
        }
        System.out.println("x^n  " +power);
        sc.close();

    }
}
