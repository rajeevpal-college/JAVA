import java.util.Scanner;
public class justnamerhega{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);

        System.out.println("enter no ");
        int num=sc.nextInt(),count=-1;

        if(num<=1){
            System.out.println("given no has no prime factors");
            sc.close();
            return;

        }
        for(int i=num/2;i>1;i--){
            if(num%i==0){
                count=0;
                for(int j=2;j<=i/2;j++){
                    if(i%j==0){
                        count++;
                        break;

                    }
                }
            }
            if (count==0){
                System.out.println("the largest prime factor  is " + i);
                break;

            }
        }

        if(count== -1){
            System.out.println("the large prime "+num);
        }
        sc.close();
    }
}
